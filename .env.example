# Arquivo de exemplo de variáveis de ambiente
# Copie este arquivo para .env.local e preencha com seus valores

# URL base do site (produção)
NEXT_PUBLIC_BASE_URL=https://ferramentasdigitais.com.br

# Google Analytics (opcional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google AdSense (opcional)
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Google Search Console (opcional)
# NEXT_PUBLIC_GSC_VERIFICATION=seu-codigo-de-verificacao
